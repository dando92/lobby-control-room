{
  "name": "@lobby-control-room/api",
  "version": "0.0.1",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start:prod": "node dist/src/main.js",
    "start:dev": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/main.ts",
    "test": "jest --config jest.config.js --runInBand --passWithNoTests"
  },
  "dependencies": {
    "@lobby-control-room/syncstart-protocol": "0.0.1",
    "@nestjs/common": "^11.1.18",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.18",
    "@nestjs/platform-express": "^11.1.18",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@types/ws": "^8.5.13",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
