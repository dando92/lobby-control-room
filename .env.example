# Where Tournament Hub answers. From inside Compose, a hub running on this
# machine is reachable at host.docker.internal.
TOURNAMENT_HUB_URL=http://host.docker.internal:3000

# Generated once on the tournament's configuration page in Tournament Hub and
# shown only that one time. The control room is the only thing that holds it;
# it never reaches a browser.
CONTROL_ROOM_KEY=

# this-machine keeps the console on loopback; venue-network opens it to the
# room and makes the operator passphrase mandatory.
CONTROL_ROOM_REACH=this-machine
CONTROL_ROOM_OPERATOR_PASSWORD=

# Where the console is published. 127.0.0.1 is this machine only; 0.0.0.0 lets
# a phone on the venue network open it.
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8080

# The SyncStart server the cabinets share. The bundled simulator is the
# default so a fresh clone has something to connect to; a real venue points
# this at its own server, or at ws://syncservice.groovestats.com:1337.
SYNCSTART_URL=ws://syncstart-simulator:19000

PLAY_PLAN_POLL_INTERVAL_SECONDS=2
